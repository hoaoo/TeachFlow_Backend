# PostgreSQL Database Configuration
POSTGRES_DB=teachflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/teachflow_db?schema=public"

# JWT Authentication (In production, must be at least 32 characters long and random)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_ISSUER=teachflow-backend
JWT_AUDIENCE=teachflow-frontend
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Routing Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
GEMINI_TIMEOUT_MS=60000
GEMINI_IMAGE_TIMEOUT_MS=90000
GEMINI_MAX_INPUT_CHARS=20000
GEMINI_MAX_OUTPUT_TOKENS=8192

# Server & Client
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Optional Production Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@teachflow.vn
BOOTSTRAP_ADMIN_PASSWORD=your_strong_admin_password_here

# Storage Configuration
RESOURCE_MAX_FILE_SIZE_MB=50
RESOURCE_MAX_IMAGE_MB=20
RESOURCE_MAX_DOC_MB=50
RESOURCE_MAX_SHEET_MB=50
RESOURCE_MAX_PPT_MB=100
RESOURCE_MAX_VIDEO_MB=500
RESOURCE_UPLOAD_DIR=uploads/resources
IMPORT_MAX_FILE_SIZE_MB=10
